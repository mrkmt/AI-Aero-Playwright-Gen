{
  "manifest_version": 3,
  "name": "AI-Aero Recorder",
  "version": "1.0.0",
  "description": "Records browser interactions and sends them to the AI-Aero-Playwright-Gen backend for automated test generation.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI-Aero Recorder"
  }
}